# CLEVR-Hans3 + Slot Attention + RNN slot selector (imitation + GRPO)
# Copy of .envA_ch3 with explicit DeepSets / RNN-selector overrides.

DEBUG=False
DEVICE=cuda

DATASET=ch
DATASET_PATH=/vol/bitbucket/kw1025/CLEVR-Hans3
DATASET_MAX_NUM_OBJ=10
DATASET_IMAGE_RESOLUTION=64
DATASET_CACHE=False
DATASET_BATCH_SIZE=64
DATASET_EVAL_BATCH_SIZE=1
LABELS=[0,1,2]

SA_WIDTH=64
SA_NUM_SLOTS=11
SA_SLOT_DIM=64
SA_ROUTING_ITERS=3

SA_SEED=8
SA_LEARNING_RATE=0.0005
SA_WEIGHT_DECAY=5e-7
SA_DETERMINISTIC=True

N_PLAYERS=2
CONSENSUS_GAME_LENGTH=3
PENALISE_SELECTIONS=False
PENALISE_SELECTIONS_WEIGHT=0
ALWAYS_CLASSIFY=True
SPARSE_REWARD_FACTOR=0
RELATIVE_CONFIDENCE_CHANGE=False
SECOND_SELECTION_UNIQUENESS_FACTOR=0
REPEAT_SELECTION_REWARD_FACTOR=0
INFORMATIVE_REPEAT_SCALING=0
END_CONDITION=confident_consensus
CONFIDENCE_THRESHOLD=0.7
PER_AGENT_UNIQUENESS=False
INFORMATION_REWARD_FACTOR=0

RNN_INPUT_SIZE=128
RNN_OUTPUT_SIZE=128

CLASSIFIER_HIDDEN=256

PLAYER_LR=0.00002
PLAYER_GAMMA=0.99
PLAYER_HIDDEN_DIM=256
BASELINE_HIDDEN_DIM=128
ENTROPY_BETA=0.001
BASELINE_BETA=0
DIVERSITY_LAMBDA=0
REDUNDANCY_LAMBDA=0
CONSENSUS_LAMBDA=0

EPOCHS=1000
TRAIN_ONLY_LAST_CLASSIFICATION=False
REINFORCE_LOSS_WEIGHT=30
CE_LOSS_WEIGHT=1.0
SA_LOSS_WEIGHT=1.0
EM_REWARD_SA_LOSS_SCALING=0.003
MAX_NORM=-1

CHECKPOINT_NAME='checkpoint'
CHECKPOINT_FILE_TYPE='.pt'
CHECKPOINT=8
LOSS_THRESHOLD=1.00
REWARD_THRESHOLD=0.5
SAVE_FREQ=5
MIN_SAVE_EPOCHS=0

EVAL_EPISODES=800
CHART_FREQUENCY=1
TEMP_TAG='_temp'

# --- DeepSets (align with trained deepsets_classifier_best.pt) ---
DS_AGGREGATE=sum
DS_PHI_HIDDEN=256
DS_RHO_HIDDEN=256
DS_TAU=0.6
DS_EPSILON=0.05

# --- RNN slot selector: imitation warm-start + GRPO ---
# Imitation: extra CE on class_head(h) vs y_hat after each slot step (weight).
RNN_SEL_IMITATION_ALPHA_CLASS=2.0
# Eval only: if True, disable p>=tau early exit after a slot (align val_k with training semantics).
RNN_SEL_EVAL_DISABLE_CONF_EARLY_EXIT=False
RNN_SEL_EMBED_DIM=256
RNN_SEL_HIDDEN_DIM=256
RNN_SEL_IMITATION_EPOCHS=10
RNN_SEL_EPOCHS=100
RNN_SEL_MAX_STEPS=11
RNN_SEL_LR=1e-4
RNN_SEL_WEIGHT_DECAY=1e-5
RNN_SEL_GRPO_GROUP_SIZE=4
RNN_SEL_GRPO_BETA=0.1
RNN_SEL_GRPO_EPS=1e-8
RNN_SEL_LAMBDA_LEN=0.05
RNN_SEL_SUCCESS_REWARD=0.5
RNN_SEL_FAIL_PENALTY=0.2
RNN_SEL_EVAL_SAMPLES=512
# If True (eval/inspect only): block STOP until class_head max prob >= DS_TAU or all slots taken.
RNN_SEL_EVAL_REQUIRE_TAU_TO_STOP=False
RNN_SEL_MAX_GRAD_NORM=0.5
RNN_SEL_GRPO_ADV_CLIP=10.0
RNN_SEL_ALPHA_CLASS=0.5
