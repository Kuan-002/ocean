# CLEVR-Hans7 — EnhancedDeepSetsClassifier training config
# Use with: python scripts/run_train_classifier.py --env_path scripts/envs/.envA_ch7_cls
#           --sa_checkpoint ./out/sa_ch7_64_3/checkpoints/sa/ --enhanced

DEBUG=False
DEVICE=cuda

DATASET=ch
DATASET_PATH=/vol/biomedic3/kw1025/ocean/scripts/datasets/CLEVR-Hans7
DATASET_MAX_NUM_OBJ=10
DATASET_IMAGE_RESOLUTION=64
DATASET_CACHE=False
DATASET_BATCH_SIZE=64
DATASET_EVAL_BATCH_SIZE=64
LABELS=[0,1,2,3,4,5,6]

# SA architecture — must match the checkpoint at ./out/sa_ch7_64_3/checkpoints/sa/
SA_WIDTH=64
SA_NUM_SLOTS=11
SA_SLOT_DIM=64
SA_ROUTING_ITERS=3
SA_SEED=8
SA_LEARNING_RATE=0.0005
SA_WEIGHT_DECAY=5e-7
SA_DETERMINISTIC=True

# --- EnhancedDeepSetsClassifier settings ---
# sum+max aggregation is wired into EnhancedDeepSetsClassifier; DS_AGGREGATE unused.
DS_AGGREGATE=sum
DS_PHI_HIDDEN=512
DS_RHO_HIDDEN=512
DS_DROPOUT=0.1
DS_LABEL_SMOOTHING=0.05

# Optimiser / scheduler (CosineAnnealingLR from ds_cls_lr down to 1% over ds_cls_epochs)
DS_CLS_LR=3e-4
DS_CLS_EPOCHS=800
DS_CLS_WEIGHT_DECAY=1e-4

# Subset evaluator (unused for plain classification, kept for compatibility)
DS_TAU=0.6
DS_EPSILON=0.05
DS_SUBSET_LR=1e-3
DS_SUBSET_EPOCHS=200
DS_SUBSET_WEIGHT_DECAY=1e-5
DS_DISTILL_TEMPERATURE=1.0
