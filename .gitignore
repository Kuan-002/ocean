# Minimal test-only repository allowlist. The retained entry point is
# scripts/eval_selector_v1_test.py, as used by Experiments/ocean_* jobs.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/scripts/
!/src/

/scripts/*
!/scripts/eval_selector_v1_test.py
!/scripts/run_test.sh

/src/*
!/src/config.py
!/src/clevr_hans_dataset.py
!/src/selector_v1_ac.py
!/src/slot_attention.py
!/src/slot_autoencoder.py

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/

slurm.sh
# Logs / OS
*.log

.DS_Store
