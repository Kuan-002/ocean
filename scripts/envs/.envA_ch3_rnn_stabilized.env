# CLEVR-Hans3 RNN selector: stabilized training (deterministic SA slots, class prewarm,
# stronger GRPO signal). Adjust DATASET_PATH to your machine.

DEBUG=False
DEVICE=cuda

DATASET=ch
DATASET_PATH=D:\ocean\scripts\datasets\CLEVR-Hans7
DATASET_MAX_NUM_OBJ=10
DATASET_IMAGE_RESOLUTION=64
DATASET_CACHE=False
DATASET_BATCH_SIZE=64
DATASET_EVAL_BATCH_SIZE=1
LABELS=[0,1,2,3,4,5,6]

SA_WIDTH=64
SA_NUM_SLOTS=11
SA_SLOT_DIM=64
SA_ROUTING_ITERS=3

SA_SEED=8
SA_LEARNING_RATE=0.0005
SA_WEIGHT_DECAY=5e-7
SA_DETERMINISTIC=True

N_PLAYERS=2
CONSENSUS_GAME_LENGTH=3
PENALISE_SELECTIONS=False
PENALISE_SELECTIONS_WEIGHT=0
ALWAYS_CLASSIFY=True
SPARSE_REWARD_FACTOR=0
RELATIVE_CONFIDENCE_CHANGE=False
SECOND_SELECTION_UNIQUENESS_FACTOR=0
REPEAT_SELECTION_REWARD_FACTOR=0
INFORMATIVE_REPEAT_SCALING=0
END_CONDITION=confident_consensus
CONFIDENCE_THRESHOLD=0.7
PER_AGENT_UNIQUENESS=False
INFORMATION_REWARD_FACTOR=0

RNN_INPUT_SIZE=128
RNN_OUTPUT_SIZE=128

CLASSIFIER_HIDDEN=256

PLAYER_LR=0.00002
PLAYER_GAMMA=0.99
PLAYER_HIDDEN_DIM=256
BASELINE_HIDDEN_DIM=128
ENTROPY_BETA=0.001
BASELINE_BETA=0
DIVERSITY_LAMBDA=0
REDUNDANCY_LAMBDA=0
CONSENSUS_LAMBDA=0

EPOCHS=1000
TRAIN_ONLY_LAST_CLASSIFICATION=False
REINFORCE_LOSS_WEIGHT=30
CE_LOSS_WEIGHT=1.0
SA_LOSS_WEIGHT=1.0
EM_REWARD_SA_LOSS_SCALING=0.003
MAX_NORM=-1

CHECKPOINT_NAME='checkpoint'
CHECKPOINT_FILE_TYPE='.pt'
CHECKPOINT=8
LOSS_THRESHOLD=1.00
REWARD_THRESHOLD=0.5
SAVE_FREQ=5
MIN_SAVE_EPOCHS=0

EVAL_EPISODES=800
CHART_FREQUENCY=1
TEMP_TAG='_temp'

DS_AGGREGATE=sum
DS_PHI_HIDDEN=256
DS_RHO_HIDDEN=256
DS_TAU=0.8
DS_EPSILON=0.05

# --- RNN slot selector (Phases 0–3) ---
RNN_SEL_FORCE_FULL_ROLLOUT=True
RNN_SEL_GLOBAL_INIT=True
RNN_SEL_AREA_WEIGHT=0.5

# Phase 0: fixed per-image SA slot init noise (reproducible slots).
RNN_SEL_SA_DETERMINISTIC_SLOTS=True
RNN_SEL_SA_NOISE_SEED=0

# Phase 1: class_head prewarm before imitation.
RNN_SEL_CLASS_PREWARM_EPOCHS=5
RNN_SEL_PREWARM_MASKS_PER_IMAGE=6

RNN_SEL_IMITATION_ALPHA_CLASS=3.0
RNN_SEL_IMITATION_EPOCHS=20
RNN_SEL_EVAL_DISABLE_CONF_EARLY_EXIT=False
RNN_SEL_EMBED_DIM=256
RNN_SEL_HIDDEN_DIM=256
RNN_SEL_EPOCHS=120
RNN_SEL_MAX_STEPS=11
RNN_SEL_LR=3e-5
RNN_SEL_WEIGHT_DECAY=1e-5
RNN_SEL_GRPO_GROUP_SIZE=8
RNN_SEL_GRPO_BETA=0.1
RNN_SEL_GRPO_EPS=1e-8
RNN_SEL_LAMBDA_LEN=0.05
RNN_SEL_SUCCESS_REWARD=0.5
RNN_SEL_FAIL_PENALTY=0.2
RNN_SEL_EVAL_SAMPLES=512
RNN_SEL_EVAL_REQUIRE_TAU_TO_STOP=False
RNN_SEL_MAX_GRAD_NORM=0.5
RNN_SEL_GRPO_ADV_CLIP=10.0
RNN_SEL_ALPHA_CLASS=2.0

# Phase 3: reward adds class match + CE bonus; KL(class_head || DeepSets prefix).
RNN_SEL_REWARD_CLS_ACC_WEIGHT=0.5
RNN_SEL_REWARD_CLS_CE_BONUS=0.3
RNN_SEL_GRPO_CLASS_TEACHER_KL=0.1
RNN_SEL_GRPO_CLASS_TEACHER_TEMP=1.0

# Curriculum: effective p_full threshold for train t* ramps from START scale to 1.0.
RNN_SEL_TSTAR_CURRICULUM_EPOCHS=90
RNN_SEL_TSTAR_CURRICULUM_START=0.7
RNN_SEL_TSTAR_P_FULL_SCALE=1.0

# Best checkpoint by RNN-only val accuracy (GT), not val_succ.
RNN_SEL_BEST_METRIC=rnn_acc
